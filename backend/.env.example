# llmwiki environment example

DATA_DIR=./data

# Default LLM configuration. The settings page can override this at runtime.
LLM_PROVIDER=openai
LLM_API_KEY=<your-api-key>
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# Optional multimodal image captioning configuration.
MULTIMODAL_MODEL=
MULTIMODAL_API_KEY=<your-multimodal-api-key>
MULTIMODAL_BASE_URL=

# Optional Deep Research search provider: tavily or serpapi.
SEARCH_API_PROVIDER=
SEARCH_API_KEY=<your-search-api-key>
SEARCH_API_BASE_URL=

APP_URL=http://localhost:8000
LOG_LEVEL=info
USER_ID=default-user
